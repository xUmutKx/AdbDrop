<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="6dp" app:cardCornerRadius="16dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
        <ImageView android:id="@+id/icon" android:layout_width="28dp" android:layout_height="28dp" app:tint="?attr/colorPrimary"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="middle" android:textAppearance="?attr/textAppearanceBodyLarge"/>
            <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:alpha="0.7"/>
        </LinearLayout>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/cb" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
