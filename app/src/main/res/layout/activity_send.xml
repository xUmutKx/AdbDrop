<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="16dp" android:clipToPadding="false" android:background="?android:colorBackground">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" android:contentDescription="Back" android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Browser / PC link"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="?attr/colorPrimary"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginTop="4dp">
        <com.roket.adbdrop.RadarView android:id="@+id/radar" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <ImageView android:id="@+id/center" android:layout_width="84dp" android:layout_height="84dp" android:layout_gravity="center" android:padding="22dp"
            android:background="@drawable/bg_icon" android:src="@drawable/ic_send" app:tint="?attr/colorOnPrimaryContainer"/>
    </FrameLayout>

    <TextView android:id="@+id/tvState" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="?attr/textAppearanceHeadlineSmall"/>
    <TextView android:id="@+id/tvDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:alpha="0.8" android:textAppearance="?attr/textAppearanceBodyMedium"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/prog" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:visibility="gone" app:trackThickness="10dp" app:trackCornerRadius="5dp"/>
    <TextView android:id="@+id/tvItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorPrimary"/>

    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/tg" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" app:singleSelection="true" app:selectionRequired="true">
        <Button android:id="@+id/tWifi" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Wi-Fi"/>
        <Button android:id="@+id/tUsb" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="USB cable"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout android:id="@+id/paneWifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:layout_marginTop="14dp">
        <com.google.android.material.card.MaterialCardView android:id="@+id/qrCard" android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF" app:cardElevation="0dp" app:cardCornerRadius="24dp" app:contentPadding="14dp">
            <ImageView android:id="@+id/qr" android:layout_width="200dp" android:layout_height="200dp" android:scaleType="fitXY"/>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/tvLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="12dp" android:textIsSelectable="true" android:textAppearance="?attr/textAppearanceBodyMedium"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:alpha="0.7" android:textAppearance="?attr/textAppearanceBodySmall"
            android:text="Scan with the other phone's camera, or open the link in any browser on the same Wi-Fi / hotspot."/>
        <Button android:id="@+id/btnCopy" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Copy link"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/paneUsb" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="14dp">
        <TextView android:id="@+id/tvUsb" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" android:textAppearance="?attr/textAppearanceBodyMedium"/>
        <Button android:id="@+id/btnUsb" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Turn on USB tethering"/>
        <Button android:id="@+id/btnUsbCopy" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copy link"/>
    </LinearLayout>

    <Button android:id="@+id/btnStop" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Stop sharing"/>
</LinearLayout>
</ScrollView>
