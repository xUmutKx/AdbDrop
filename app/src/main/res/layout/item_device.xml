<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardCornerRadius="24dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
        <ImageView android:id="@+id/dIcon" android:layout_width="52dp" android:layout_height="52dp" android:padding="13dp" android:background="@drawable/bg_icon" app:tint="?attr/colorOnPrimaryContainer"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
            <TextView android:id="@+id/dName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium"/>
            <TextView android:id="@+id/dSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:alpha="0.75" android:textAppearance="?attr/textAppearanceBodySmall"/>
        </LinearLayout>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_send" app:tint="?attr/colorPrimary"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
